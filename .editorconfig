# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[{*.sh,todo.cfg,todo_completion,usageToMarkdown}]
indent_style = space
indent_size = 4

[tests/{aggregate-results,test-lib}.sh]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_style = space
indent_size = 2
