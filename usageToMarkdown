#!/usr/bin/sed -f

# Add level 1 heading.
1i\
# [todo.txt-cli](http://todotxt.org) Usage\

# Format usage as code block.
s/^  Usage: .*$/```\
&\
```/
t

:restart
# Level 2 headings.
s/^  \([[:alpha:]].*\):$/## \1/
# Level 3 headings need more processing.
/^    [^[:space:]]/{
    N
    b levelThree
}

# Backslashes and underscores need to be escaped for Markdown.
s/\\/\\\\/g
s/_/\\_/g

# Lists have an indent of 10 spaces.
s/^ \{10\}\([^[:space:]].*\)/* \1/
# Anything else with more than 4 spaces of indentation is plain text.
s/^ \{5,\}//
b

:levelThree
# Format options.
s/^    \(-[^[:space:]]\{1,\}.*\)\n/### \1\
\
/
t printAndRestartWithLastLine
# Special handling of addm that has a single shell command over two lines.
s/^    \([^[:space:]]\{1,\}\)\( "[^"]*\)\n    \([^[:space:]][^"]*"\)$/### \1\
\
```shell\
$ todo.sh \1\2\
\3\
```\
/
# No lookahead
t

# Handle actions (like add|a) that have a short alias.
s/^    \([^[:space:]]\{1,\}\)\(.*\)\n    \([^[:space:]]\{1,\}\)\(.*\)$/### \1\
\
```shell\
$ todo.sh \1\2\
$ todo.sh \3\4\
```\
/
t printAndRestartWithLastLine

# Normal actions.
s/^    \([^[:space:]]\{1,\}\)\(.*\)\n/### \1\
\
```shell\
$ todo.sh \1\2\
```\
/

# The lookahead line didn't belong to the action, so print all lines that render
# the action and restart processing with the lookahead line in pattern space.
:printAndRestartWithLastLine
# Escape underscores (found in the environment variables) in the added heading
# (i.e. the first line), but not in the (following) code block.
y/\n//
# XXX: In POSIX sed, [^\n]* is ineffective and matches like .*; work around by
# temporarily translating newlines to another unused character.
    s/^\([^\]*\)_\([^]*\)/\1\\_\2/
    t printAndRestartWithLastLine
y//\n/

:printAndRestartLoop
/\n/!b restart
P
y/\n//
    s/^[^]*//
y//\n/
b printAndRestartLoop
