#!/usr/bin/env bash
# Based on git's GIT-VERSION-GEN.

VF=VERSION-FILE
DEF_VER=v0.0.0

if [ -d .git ] || [ -f .git ] \
    && VN=$(git describe --dirty --tags 2>/dev/null)
then
    VN=${VN//-/.}
else
    VN="$DEF_VER"
fi
VN=${VN#v}

VC=
[ -r "$VF" ] && VC=$(sed -e 's/^VERSION=//' <"$VF")
[ "$VN" = "$VC" ] \
    || echo "VERSION=$VN" | tee "$VF" >&2
